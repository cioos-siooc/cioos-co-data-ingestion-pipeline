# Python
__pycache__/
.venv/
.pytest_cache/

# Local environment (copy .env.example)
.env

# Per-pipeline runtime work dirs (downloaded zips / extracted CSVs / mirrored
# NetCDF / SWOB XML) — everything under data/ is regenerable.
/data/

# Pipeline output published for ERDDAP (regenerated by the pipelines).
datasets/

# ERDDAP runtime state and the datasets.xml the axiom image assembles from
# datasets.d/ at container start (plus the timestamped backups it makes).
erddap/data/
erddap/content/datasets.xml
erddap/content/datasets.xml.*.bak

# ECCC station->fields mapping is runtime-generated (the parser appends new
# stations as they appear on the AMQP feed); the types file IS tracked.
config/eccc/ECCCbuoys_json_fields.json

# GenerateDatasetsXml draft output and ERDDAP tool logs.
logs/

*.log
*.log.previous
*.bak
