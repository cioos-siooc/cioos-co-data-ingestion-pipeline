# Python
__pycache__/
.venv/
.pytest_cache/

# Local environment (copy .env.example)
.env

# Per-pipeline runtime work dirs (downloaded zips / extracted CSVs / mirrored
# NetCDF / SWOB XML) — everything under data/ is regenerable.
data/

# Local pipeline output, when PUBLISH_URL points at file:// instead of the
# bucket (regenerated by the pipelines; also what scripts/ reads).
datasets/

# Leftover local ERDDAP runtime state from before the pipelines published to
# object storage. Nothing writes it any more — safe to delete; ignored so it
# doesn't show up as untracked noise in existing checkouts.
erddap/

# ECCC station->fields mapping is runtime-generated (the parser appends new
# stations as they appear on the AMQP feed); the types file IS tracked.
config/eccc/ECCCbuoys_json_fields.json

# GenerateDatasetsXml draft output and ERDDAP tool logs.
logs/

*.log
*.log.previous
*.bak
