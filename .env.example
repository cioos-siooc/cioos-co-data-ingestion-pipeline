# Copy to .env and fill in the two credentials. .env is gitignored — the real
# keys must never be committed, logged, or baked into an image.
#
# The key CIOOS issues can read, write and delete ANY bucket in the CIOOS
# project, not just this one. Report a leak to the CIOOS infrastructure team
# immediately; it is revocable in seconds.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Destination bucket + prefix. Pipelines publish to <PUBLISH_URL>/<dataset>/,
# e.g. datasets/ECCCbuoys/*.csv. Point this at file:///app/datasets to publish
# locally instead (useful with scripts/, which read ./datasets).
PUBLISH_URL=s3://cioos-juno-buoy-data/datasets

# The Juno object store is a Ceph RADOS Gateway, not AWS. The region is a
# placeholder the gateway ignores, but most SDKs refuse to start without one.
AWS_ENDPOINT_URL=https://objets.juno.calculquebec.ca
AWS_DEFAULT_REGION=us-east-1
