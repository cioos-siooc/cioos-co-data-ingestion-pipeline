<?xml version="1.0" encoding="UTF-8"?>
<!--
  DEMO VERSION 2 — Argo Canada (MEDS DAC) profiles served from locally mirrored
  GDAC NetCDF files. Curated, hand-tuned definition; sourceNames/dtypes/units/
  _FillValues verified against a real file (4902674_prof.nc, Ifremer GDAC).

  GenerateDatasetsXml_argomeds.sh installs this into
  cioos-national-erddap/datasets.d/ARGO_MEDS.xml, where sync-erddap-datasets.py
  merges it into datasets.xml. The Argo_MEDS_Parser pipeline keeps
  /datasets/ARGO_MEDS/ stocked with <WMO>_prof.nc files.

  Argo _prof.nc files are CF DSG "incomplete multidimensional array" files
  (N_PROF x N_LEVELS); EDDTableFromMultidimNcFiles flattens them to one row per
  (profile, level) and removeMVRows drops the fill-padded levels.

  DELIBERATE RESHAPE FOR CIOOS/CDE: Argo's natural cdm_data_type is
  TrajectoryProfile, but the CIOOS Data Explorer harvester (cde_harvester,
  explore-cioos repo) skips Trajectory/TrajectoryProfile datasets
  (CDM_DATA_TYPE_UNSUPPORTED). We therefore advertise TimeSeriesProfile:
  each float (platform_number, cf_role=timeseries_id) is a "timeseries" of
  per-cycle profiles (cycle_number, cf_role=profile_id). Every cycle has its
  own lat/lon, so CDE's distinct(id, lat, lon) profile extraction yields one
  point per cycle - correct for Argo. Revisit if/when CDE gains real
  TrajectoryProfile support.

  Other notable choices:
  - PSAL's standard_name is overridden to sea_water_practical_salinity (the
    files say sea_water_salinity, but the variable IS practical salinity, units
    psu, and CDE's EOV mapping keys on the _practical_ name).
  - TEMP/PSAL/PRES keep their in-file _FillValue=99999.0 (JULD: 999999.0);
    with removeMVRows the padded levels disappear from the table.
  - *_ADJUSTED variants are exposed so delayed-mode (data_mode="D") users get
    the QC'd values; per-level QC flags ride along as strings.
  - lat/lon units are normalised to degrees_north/degrees_east (files say
    degree_north/degree_east; ERDDAP requires the plural for the special
    latitude/longitude destinations).
-->
<erddapDatasets>

    <dataset type="EDDTableFromMultidimNcFiles" datasetID="ARGO_MEDS" active="true">
        <reloadEveryNMinutes>1440</reloadEveryNMinutes>
        <updateEveryNMillis>10000</updateEveryNMillis>
        <fileDir>/datasets/ARGO_MEDS/</fileDir>
        <fileNameRegex>.*_prof\.nc</fileNameRegex>
        <recursive>true</recursive>
        <pathRegex>.*</pathRegex>
        <metadataFrom>last</metadataFrom>
        <standardizeWhat>0</standardizeWhat>
        <removeMVRows>true</removeMVRows>
        <sortFilesBySourceNames>PLATFORM_NUMBER</sortFilesBySourceNames>
        <fileTableInMemory>false</fileTableInMemory>
        <accessibleViaFiles>true</accessibleViaFiles>
        <addAttributes>
            <att name="cdm_data_type">TimeSeriesProfile</att>
            <att name="cdm_timeseries_variables">platform_number</att>
            <att name="cdm_profile_variables">cycle_number, time, latitude, longitude, direction, data_mode</att>
            <!-- Argo's vertical coordinate is pressure (decibar), not depth/altitude.
                 ERDDAP requires profile-type datasets to name a vertical proxy when no
                 depth/altitude variable exists; pressure ~ depth in the ocean. -->
            <att name="cdm_altitude_proxy">pressure</att>
            <att name="subsetVariables">platform_number, data_center, data_mode, direction</att>
            <att name="Conventions">Argo-3.1, CF-1.6, COARDS, ACDD-1.3</att>
            <att name="infoUrl">https://www.meds-sdmm.dfo-mpo.gc.ca/isdm-gdsi/argo/index-eng.html</att>
            <att name="institution">Fisheries and Oceans Canada (DFO), Marine Environmental Data Section (MEDS)</att>
            <att name="creator_name">Argo Canada / MEDS, Fisheries and Oceans Canada</att>
            <att name="creator_url">https://www.meds-sdmm.dfo-mpo.gc.ca/isdm-gdsi/argo/index-eng.html</att>
            <att name="keywords">argo, profiling float, ocean, temperature, salinity, pressure, profile, DFO, MEDS, Canada, GDAC, sea water temperature, sea water practical salinity, in-situ, Earth Science &gt; Oceans &gt; Ocean Temperature &gt; Water Temperature, Earth Science &gt; Oceans &gt; Salinity/Density &gt; Salinity</att>
            <att name="keywords_vocabulary">GCMD Science Keywords</att>
            <att name="license">Argo data are freely available without restriction (Argo data policy). Please acknowledge: "These data were collected and made freely available by the International Argo Program and the national programs that contribute to it (https://argo.ucsd.edu, https://www.ocean-ops.org). The Argo Program is part of the Global Ocean Observing System."</att>
            <att name="references">https://argo.ucsd.edu/ ; https://www.argodatamgt.org/ ; Argo User's Manual, https://doi.org/10.13155/29825</att>
            <att name="source">Argo float profiles, Argo GDAC dac/meds aggregated _prof.nc files</att>
            <att name="sourceUrl">https://data-argo.ifremer.fr/dac/meds/</att>
            <att name="standard_name_vocabulary">CF Standard Name Table v55</att>
            <att name="summary">Vertical profiles of in-situ temperature, practical salinity and pressure from Argo profiling floats operated by Argo Canada (DFO Marine Environmental Data Section, MEDS - Argo data-centre code "ME"). Mirrored from the aggregated per-float profile files (WMO_prof.nc) in the dac/meds tree of the Argo Global Data Assembly Centre, so both real-time (data_mode=R/A) and delayed-mode QC'd (data_mode=D) cycles are included, along with adjusted values and per-level QC flags. One row per (cycle, level); each float is presented as a time series of per-cycle profiles.</att>
            <att name="title">Argo Canada profiling float profiles (MEDS DAC, GDAC mirror)</att>
        </addAttributes>

        <dataVariable>
            <sourceName>PLATFORM_NUMBER</sourceName>
            <destinationName>platform_number</destinationName>
            <dataType>String</dataType>
            <addAttributes>
                <att name="cf_role">timeseries_id</att>
                <att name="ioos_category">Identifier</att>
                <att name="long_name">Float WMO identifier</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>CYCLE_NUMBER</sourceName>
            <destinationName>cycle_number</destinationName>
            <dataType>int</dataType>
            <addAttributes>
                <att name="cf_role">profile_id</att>
                <att name="ioos_category">Identifier</att>
                <att name="long_name">Float cycle number</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>JULD</sourceName>
            <destinationName>time</destinationName>
            <dataType>double</dataType>
            <addAttributes>
                <att name="ioos_category">Time</att>
                <att name="long_name">Time of the profile (JULD)</att>
                <att name="standard_name">time</att>
                <att name="source_name">JULD</att>
                <att name="units">days since 1950-01-01T00:00:00Z</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>JULD_QC</sourceName>
            <destinationName>time_qc</destinationName>
            <dataType>String</dataType>
            <addAttributes>
                <att name="ioos_category">Quality</att>
                <att name="long_name">Quality on profile date and time (Argo reference table 2)</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>LATITUDE</sourceName>
            <destinationName>latitude</destinationName>
            <dataType>double</dataType>
            <addAttributes>
                <att name="ioos_category">Location</att>
                <att name="colorBarMaximum" type="double">90.0</att>
                <att name="colorBarMinimum" type="double">-90.0</att>
                <att name="long_name">Latitude of the profile, best estimate</att>
                <att name="standard_name">latitude</att>
                <att name="units">degrees_north</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>LONGITUDE</sourceName>
            <destinationName>longitude</destinationName>
            <dataType>double</dataType>
            <addAttributes>
                <att name="ioos_category">Location</att>
                <att name="colorBarMaximum" type="double">180.0</att>
                <att name="colorBarMinimum" type="double">-180.0</att>
                <att name="long_name">Longitude of the profile, best estimate</att>
                <att name="standard_name">longitude</att>
                <att name="units">degrees_east</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>POSITION_QC</sourceName>
            <destinationName>position_qc</destinationName>
            <dataType>String</dataType>
            <addAttributes>
                <att name="ioos_category">Quality</att>
                <att name="long_name">Quality on position (Argo reference table 2)</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>DIRECTION</sourceName>
            <destinationName>direction</destinationName>
            <dataType>String</dataType>
            <addAttributes>
                <att name="ioos_category">Location</att>
                <att name="long_name">Direction of the profile (A: ascending, D: descending)</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>DATA_MODE</sourceName>
            <destinationName>data_mode</destinationName>
            <dataType>String</dataType>
            <addAttributes>
                <att name="ioos_category">Quality</att>
                <att name="long_name">Data mode (R: real-time, D: delayed-mode, A: real-time with adjustment)</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>DATA_CENTRE</sourceName>
            <destinationName>data_center</destinationName>
            <dataType>String</dataType>
            <addAttributes>
                <att name="ioos_category">Identifier</att>
                <att name="long_name">Data centre in charge of float data processing (ME = MEDS, Canada)</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>PRES</sourceName>
            <destinationName>pressure</destinationName>
            <dataType>float</dataType>
            <addAttributes>
                <att name="ioos_category">Pressure</att>
                <att name="long_name">Sea water pressure, equals 0 at sea-level</att>
                <att name="standard_name">sea_water_pressure</att>
                <att name="units">decibar</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>PRES_QC</sourceName>
            <destinationName>pressure_qc</destinationName>
            <dataType>String</dataType>
            <addAttributes>
                <att name="ioos_category">Quality</att>
                <att name="long_name">Pressure quality flag (Argo reference table 2)</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>PRES_ADJUSTED</sourceName>
            <destinationName>pressure_adjusted</destinationName>
            <dataType>float</dataType>
            <addAttributes>
                <att name="ioos_category">Pressure</att>
                <att name="long_name">Sea water pressure, adjusted (delayed-mode QC)</att>
                <att name="standard_name">sea_water_pressure</att>
                <att name="units">decibar</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>TEMP</sourceName>
            <destinationName>temperature</destinationName>
            <dataType>float</dataType>
            <addAttributes>
                <att name="ioos_category">Temperature</att>
                <att name="colorBarMaximum" type="double">32.0</att>
                <att name="colorBarMinimum" type="double">-2.0</att>
                <att name="long_name">Sea temperature in-situ ITS-90 scale</att>
                <att name="standard_name">sea_water_temperature</att>
                <att name="units">degree_Celsius</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>TEMP_QC</sourceName>
            <destinationName>temperature_qc</destinationName>
            <dataType>String</dataType>
            <addAttributes>
                <att name="ioos_category">Quality</att>
                <att name="long_name">Temperature quality flag (Argo reference table 2)</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>TEMP_ADJUSTED</sourceName>
            <destinationName>temperature_adjusted</destinationName>
            <dataType>float</dataType>
            <addAttributes>
                <att name="ioos_category">Temperature</att>
                <att name="colorBarMaximum" type="double">32.0</att>
                <att name="colorBarMinimum" type="double">-2.0</att>
                <att name="long_name">Sea temperature in-situ ITS-90 scale, adjusted (delayed-mode QC)</att>
                <att name="standard_name">sea_water_temperature</att>
                <att name="units">degree_Celsius</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>PSAL</sourceName>
            <destinationName>salinity</destinationName>
            <dataType>float</dataType>
            <addAttributes>
                <att name="ioos_category">Salinity</att>
                <att name="colorBarMaximum" type="double">37.0</att>
                <att name="colorBarMinimum" type="double">30.0</att>
                <att name="long_name">Practical salinity</att>
                <att name="standard_name">sea_water_practical_salinity</att>
                <att name="units">PSU</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>PSAL_QC</sourceName>
            <destinationName>salinity_qc</destinationName>
            <dataType>String</dataType>
            <addAttributes>
                <att name="ioos_category">Quality</att>
                <att name="long_name">Practical salinity quality flag (Argo reference table 2)</att>
            </addAttributes>
        </dataVariable>
        <dataVariable>
            <sourceName>PSAL_ADJUSTED</sourceName>
            <destinationName>salinity_adjusted</destinationName>
            <dataType>float</dataType>
            <addAttributes>
                <att name="ioos_category">Salinity</att>
                <att name="colorBarMaximum" type="double">37.0</att>
                <att name="colorBarMinimum" type="double">30.0</att>
                <att name="long_name">Practical salinity, adjusted (delayed-mode QC)</att>
                <att name="standard_name">sea_water_practical_salinity</att>
                <att name="units">PSU</att>
            </addAttributes>
        </dataVariable>
    </dataset>

</erddapDatasets>
